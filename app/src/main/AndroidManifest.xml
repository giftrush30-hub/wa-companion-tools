        <receiver android:name=".ReminderReceiver" android:exported="false" />\n        <provider android:name=".NaijaStickerProvider" android:authorities="com.example.wacompanion.stickers" android:enabled="true" android:exported="true" android:readPermission="com.whatsapp.sticker.READ" />
